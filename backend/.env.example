DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Lower cost: deepseek-v4-flash. Higher quality alignment: deepseek-v4-pro.
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_THINKING=disabled

# Spatial IELTS visual feedback (map and process tasks)
# Create the key in Alibaba Cloud Model Studio, China (Beijing) region.
WAN_API_KEY=your_dashscope_api_key_here
WAN_IMAGE_MODEL=wan2.7-image
# Use cn-beijing by default. For Alibaba Cloud International/Singapore, use ap-southeast-1.
ALIBABA_MODEL_STUDIO_REGION=cn-beijing
# Recommended: set the workspace ID to use the Beijing workspace endpoint.
WAN_WORKSPACE_ID=your_bailian_workspace_id_here
# Optional Wan-specific region override.
WAN_REGION=
# Optional complete endpoint override. Leave blank when WAN_WORKSPACE_ID is set.
WAN_API_ENDPOINT=

# Map/process sample essays use Qwen visual understanding. By default the
# WAN_API_KEY and WAN_WORKSPACE_ID above are reused.
QWEN_VL_MODEL=qwen3.7-plus
# Optional overrides; leave blank to reuse the Wan key/workspace.
QWEN_VL_API_KEY=
QWEN_VL_WORKSPACE_ID=
QWEN_VL_REGION=
QWEN_VL_BASE_URL=

# Fixed research-test accounts. Keep the real values in backend/.env only.
APP_AUTH_ENABLED=false
APP_TEST_USERS=tester01,tester02,tester03,tester04,tester05
APP_SHARED_PASSWORD_HASH=
APP_SESSION_SECRET=
APP_SESSION_TTL_SECONDS=43200
# Change to true after the site is served over HTTPS.
APP_COOKIE_SECURE=false
